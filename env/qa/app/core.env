RAILS_ENV=qa
RAILS_LOG_TO_STDOUT=true
RAILS_MASTER_KEY=__SET_MANUALLY__
APP_PORT=3000
DEFAULT_CLIENT_EMAIL=client@example.com
DEFAULT_PM_EMAIL=pm@example.com

# SMTP vars are supplied through deploy secrets / environment variables:
# SMTP_ADDRESS
# SMTP_PORT
# SMTP_DOMAIN
# SMTP_USER_NAME
# SMTP_PASSWORD
# SMTP_AUTHENTICATION
# SMTP_ENABLE_STARTTLS_AUTO

# ActiveStorage vars are supplied through deploy secrets / environment variables:
# AWS_ACCESS_KEY_ID
# AWS_SECRET_ACCESS_KEY
# AWS_REGION
# AWS_BUCKET
# AWS_ENDPOINT
# AWS_FORCE_PATH_STYLE
