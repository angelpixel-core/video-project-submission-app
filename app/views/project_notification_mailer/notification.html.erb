<h1><%= case @recipient_role
when "pm"
  case @event_type
  when "project_created"
    "New order created"
  when "project_accepted"
    "Order accepted"
  when "project_rejected"
    "Order rejected"
  else
    "Order update"
  end
else
  case @event_type
  when "project_created"
    "Your order was created"
  when "project_accepted"
    "Your order was accepted"
  when "project_rejected"
    "Your order needs attention"
  else
    "Order update"
  end
end %></h1>

<p><strong>Order:</strong> <%= @project.name %></p>
<p><strong>Client:</strong> <%= @project.owner.name %></p>
<p><strong>Status:</strong> <%= @project.status.humanize %></p>
<p><strong>Budget:</strong> <%= number_to_currency(@project.total_budget_cents.to_f / 100, unit: (@project.payments.first&.currency || "USD") + " ") %></p>

<% if @recipient_role == "pm" %>
  <% if @event_type == "project_created" %>
    <p>This order is ready for review and next-step planning.</p>
  <% elsif @event_type == "project_accepted" %>
    <p>The client has been notified and the order is moving forward.</p>
  <% elsif @event_type == "project_rejected" %>
    <p>The client should be notified of the requested changes.</p>
  <% end %>
<% else %>
  <% if @event_type == "project_created" %>
    <p>Next step: Your PM will review the order and move it forward.</p>
  <% elsif @event_type == "project_accepted" %>
    <p>Next step: Your PM has accepted the order and work is in progress.</p>
  <% elsif @event_type == "project_rejected" %>
    <p>Next step: Your PM needs changes before the order can move forward.</p>
  <% end %>
<% end %>
