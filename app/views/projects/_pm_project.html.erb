<div class="col-12 col-lg-6">
  <div class="card h-100 shadow-sm border-0">
    <div class="card-body">
      <div class="d-flex justify-content-between align-items-start gap-3 mb-3">
        <div>
          <h2 class="h5 mb-1"><%= project.name.presence || "Untitled project" %></h2>
          <p class="mb-0 text-body-secondary"><%= project.client.name %></p>
        </div>
        <div class="d-flex flex-column align-items-end gap-2">
          <span class="badge <%= project.pending? ? "text-bg-secondary" : project.in_progress? ? "text-bg-info" : "text-bg-success" %> text-uppercase"><%= project.pending? ? "Pendiente" : project.in_progress? ? "En progreso" : "Completado" %></span>
          <% if project.pending? %>
            <%= button_to "Aceptar proyecto", accept_project_path(project), method: :patch, class: "btn btn-sm btn-outline-primary" %>
          <% elsif project.in_progress? %>
            <%= button_to "Marcar como completado", complete_project_path(project), method: :patch, class: "btn btn-sm btn-outline-success" %>
          <% end %>
        </div>
      </div>

      <div class="mb-3">
        <p class="text-uppercase small text-body-secondary mb-2">Video types</p>
        <% if project.video_types.any? %>
          <ul class="list-unstyled mb-0">
            <% project.video_type_selections.includes(:video_type).each do |selection| %>
              <li class="d-flex justify-content-between gap-3 py-1">
                <span><%= selection.video_type.name %></span>
                <span class="text-body-secondary">Qty <%= selection.quantity %></span>
              </li>
            <% end %>
          </ul>
        <% else %>
          <p class="mb-0 text-body-secondary">No selections recorded yet.</p>
        <% end %>
      </div>

      <div class="small text-body-secondary">
        Client: <%= project.client.name %>
      </div>
    </div>
  </div>
</div>
