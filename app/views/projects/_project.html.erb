<div class="col-12 col-lg-6">
  <div class="card h-100 shadow-sm border-0 client-project-card">
    <div class="card-body">
      <div class="d-flex justify-content-between align-items-start gap-3 mb-3">
        <div>
          <h2 class="h5 mb-1"><%= project.name.presence || "Untitled project" %></h2>
          <p class="mb-0 text-body-secondary"><%= project.raw_footage_url.presence || "No footage URL yet" %></p>
        </div>
        <div class="d-flex flex-column align-items-end gap-2">
          <span class="badge <%= project.draft? ? "text-bg-warning" : project.pending? ? "text-bg-secondary" : project.in_progress? ? "text-bg-info" : "text-bg-success" %> text-uppercase"><%= project.draft? ? "Borrador" : project.pending? ? "Pendiente" : project.in_progress? ? "En progreso" : "Completado" %></span>
          <% if project.draft? %>
            <%= link_to "Reanudar", edit_project_path(project), class: "btn btn-sm btn-outline-primary", data: { role_scope: "client" } %>
          <% else %>
            <%= link_to "View details", project_path(project), class: "btn btn-sm btn-outline-secondary", data: { role_scope: "client" } %>
          <% end %>
        </div>
      </div>

      <% if youtube_thumbnail_url(project.youtube_url).present? %>
        <%= link_to project_path(project), class: "d-block text-reset text-decoration-none mb-3 youtube-preview" do %>
          <div class="ratio ratio-16x9 rounded-3 overflow-hidden bg-dark position-relative youtube-preview-shell">
            <%= image_tag youtube_thumbnail_url(project.youtube_url), alt: "YouTube preview for #{project.name.presence || 'project'}", class: "w-100 h-100 object-fit-cover" %>
            <div class="position-absolute top-50 start-50 translate-middle">
              <span class="btn btn-light rounded-pill px-3 shadow-sm">Play preview</span>
            </div>
          </div>
        <% end %>
      <% end %>

      <div class="mb-3">
        <p class="text-uppercase small text-body-secondary mb-2">Video types</p>
        <% if project.video_types.any? %>
          <ul class="list-unstyled mb-0">
            <% project.video_type_selections.includes(:video_type).each do |selection| %>
              <li class="d-flex justify-content-between gap-3 py-1">
                <span><%= selection.video_type.name %></span>
                <span class="text-body-secondary">Qty <%= selection.quantity %></span>
              </li>
            <% end %>
          </ul>
        <% else %>
          <p class="mb-0 text-body-secondary">No selections recorded yet.</p>
        <% end %>
      </div>

      <div class="small text-body-secondary">
        PM: <%= project.pm.name %>
      </div>
    </div>
  </div>
</div>
