<div class="dropdown-item-text px-3 py-2 border-bottom pm-notification-item pm-notification-row bg-primary-subtle" data-role-scope="pm">
  <div class="d-flex align-items-start gap-3">
    <%= link_to project_path(notification.project), class: "flex-grow-1 text-reset text-decoration-none d-block min-w-0" do %>
      <p class="text-uppercase text-body-secondary small mb-1">Project update</p>
      <h3 class="h6 mb-1 pm-notification-project-name text-truncate"><%= notification.project.name %></h3>
      <p class="mb-0 text-body-secondary text-truncate"><%= notification.body %></p>
    <% end %>

    <%= form_with url: notification_path(notification), method: :patch, local: true, data: { controller: "notification-action", action: "submit->notification-action#submit" } do |form| %>
      <%= form.button class: "pm-notification-check btn btn-sm btn-link text-success p-0", aria: { label: "Mark as read" } do %>
        <svg aria-hidden="true" viewBox="0 0 16 16" width="16" height="16" fill="currentColor">
          <path d="M13.854 3.646a.5.5 0 0 1 0 .708l-7 7a.5.5 0 0 1-.708 0l-4-4a.5.5 0 1 1 .708-.708L6.5 10.293l6.646-6.647a.5.5 0 0 1 .708 0Z"/>
        </svg>
      <% end %>
    <% end %>
  </div>
</div>
