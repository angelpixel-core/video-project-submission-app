<div class="col-12 col-md-6">
  <div class="card h-100 border-0 bg-light" data-order-form-video-type-card>
    <div class="card-body d-flex flex-column gap-3">
      <div class="d-flex justify-content-between gap-3">
        <div>
          <h3 class="h6 mb-1"><%= video_type.name %></h3>
          <p class="small text-body-secondary mb-0"><%= video_type.description %></p>
        </div>
        <span class="fw-semibold"><%= money_to_currency(video_type.price_cents) %></span>
      </div>

      <div class="d-flex gap-2 align-items-center">
        <label class="form-label mb-0" for="video-type-<%= video_type.id %>-quantity">Qty</label>
        <input id="video-type-<%= video_type.id %>-quantity" type="number" min="1" value="1" class="form-control form-control-sm" style="max-width: 5rem;" data-order-form-quantity-input>
        <button type="button" class="btn btn-sm btn-primary ms-auto" data-action="click->order-form#addSelection" data-video-type-id="<%= video_type.id %>" data-video-type-name="<%= video_type.name %>" data-price-cents="<%= video_type.price_cents %>">Add</button>
      </div>
    </div>
  </div>
</div>
