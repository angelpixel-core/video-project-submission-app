<div class="modal fade" tabindex="-1" aria-hidden="true" data-order-form-target="paymentModal">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header">
        <h2 class="modal-title h5">Payment details</h2>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body">
        <div class="alert alert-info d-flex justify-content-between align-items-center">
          <span>Total due</span>
          <strong data-order-form-target="cartTotal">$0.00</strong>
        </div>

        <p class="text-muted small mb-3">This is a simulated payment step for project checkout.</p>

        <div class="payment-card-stage mb-4">
          <div class="payment-card-shell" data-order-form-target="paymentCardShell">
            <div class="payment-card-face payment-card-face-front" data-order-form-target="paymentCardFront">
              <div class="payment-card-front-grid">
                <div class="payment-card-field payment-card-number-field">
                  <label class="payment-card-label" for="payment-card-number">Card number</label>
                  <input id="payment-card-number" type="text" class="form-control payment-card-input payment-card-input-lg" placeholder="4242 4242 4242 4242" data-order-form-target="paymentCardNumber" data-action="input->order-form#syncFields blur->order-form#validatePaymentFieldsOnBlur" aria-describedby="payment-card-error">
                </div>

                <button type="button" class="payment-card-chip-trigger" data-action="click->order-form#focusPaymentCvc" aria-label="Enter card security code">
                  <span class="visually-hidden">Enter card security code</span>
                  <svg viewBox="0 0 48 34" focusable="false" role="presentation" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                    <rect x="1.5" y="1.5" width="45" height="31" rx="5" fill="none" stroke="currentColor" stroke-opacity="0.15" stroke-width="3"/>
                    <path d="M10 6.5H38M10 11.5H38M10 16.5H38M10 21.5H38M10 26.5H38" stroke="currentColor" stroke-opacity="0.18" stroke-width="2" stroke-linecap="round"/>
                  </svg>
                </button>

                <div class="payment-card-field payment-card-field-grow">
                  <label class="payment-card-label" for="payment-name">Cardholder</label>
                  <input id="payment-name" type="text" class="form-control payment-card-input" data-order-form-target="paymentName" data-action="input->order-form#syncFields blur->order-form#validatePaymentFieldsOnBlur" aria-describedby="payment-card-error">
                </div>

                <div class="payment-card-field payment-card-expiry-field">
                  <label class="payment-card-label" for="payment-card-expiry">Expiry</label>
                  <input id="payment-card-expiry" type="text" class="form-control payment-card-input" placeholder="12/28" data-order-form-target="paymentCardExpiry" data-action="input->order-form#syncFields blur->order-form#validatePaymentFieldsOnBlur" aria-describedby="payment-card-error">
                </div>
              </div>
            </div>

            <div class="payment-card-face payment-card-face-back" data-order-form-target="paymentCardBack">
              <div class="payment-card-magnetic-strip"></div>
              <div class="payment-card-cvc-row">
                <label class="payment-card-label" for="payment-card-cvc">CVC</label>
                <input id="payment-card-cvc" type="text" class="form-control payment-card-input payment-card-input-back" placeholder="123" data-order-form-target="paymentCardCvc" data-action="blur->order-form#unflipPaymentCard blur->order-form#validatePaymentFieldsOnBlur input->order-form#syncFields" aria-describedby="payment-card-error">
              </div>
            </div>
          </div>
        </div>

        <p id="payment-card-error" class="payment-card-error d-none mb-3" data-order-form-target="paymentCardError" role="alert" aria-live="polite"></p>

        <div class="mb-3">
          <label class="form-label" for="payment-email">Billing email</label>
          <input id="payment-email" type="email" class="form-control" data-order-form-target="paymentEmail" data-action="input->order-form#syncFields">
        </div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
        <button type="button" class="btn btn-primary" data-action="click->order-form#beginFinalize" data-order-form-target="finalizeButton">
          <span data-order-form-target="finalizeButtonLabel">Pay and create project</span>
          <span class="d-none d-inline-flex align-items-center gap-2" data-order-form-target="finalizeButtonSpinner">
            <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
            <span>Creating project...</span>
          </span>
        </button>
      </div>
    </div>
  </div>
</div>
