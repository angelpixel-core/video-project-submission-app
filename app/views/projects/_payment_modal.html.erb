<div class="modal fade" tabindex="-1" aria-hidden="true" data-order-form-target="paymentModal">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header">
        <h2 class="modal-title h5">Payment details</h2>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body">
        <div class="alert alert-info d-flex justify-content-between align-items-center">
          <span>Total due</span>
          <strong data-order-form-target="cartTotal">$0.00</strong>
        </div>

        <div class="mb-3">
          <label class="form-label">Name on card</label>
          <input type="text" class="form-control" data-order-form-target="paymentName" data-action="input->order-form#syncFields">
        </div>

        <div class="mb-3">
          <label class="form-label">Billing email</label>
          <input type="email" class="form-control" data-order-form-target="paymentEmail" data-action="input->order-form#syncFields">
        </div>

        <div class="row g-3">
          <div class="col-12">
            <label class="form-label" for="payment-card-number">Card number</label>
            <input id="payment-card-number" type="text" class="form-control" placeholder="4242 4242 4242 4242" data-order-form-target="paymentCardNumber">
          </div>
          <div class="col-6">
            <label class="form-label" for="payment-card-expiry">Expiry</label>
            <input id="payment-card-expiry" type="text" class="form-control" placeholder="12/28" data-order-form-target="paymentCardExpiry">
          </div>
          <div class="col-6">
            <label class="form-label" for="payment-card-cvc">CVC</label>
            <input id="payment-card-cvc" type="text" class="form-control" placeholder="123" data-order-form-target="paymentCardCvc">
          </div>
        </div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
        <button type="button" class="btn btn-primary" data-action="click->order-form#beginFinalize" data-order-form-target="finalizeButton">
          <span data-order-form-target="finalizeButtonLabel">Pay and create project</span>
          <span class="d-none d-inline-flex align-items-center gap-2" data-order-form-target="finalizeButtonSpinner">
            <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
            <span>Creating project...</span>
          </span>
        </button>
      </div>
    </div>
  </div>
</div>
