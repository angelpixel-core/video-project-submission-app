<% content_for :title, @project.name.presence || "Project details" %>

<div class="container py-4" data-project-id="<%= @project.id %>">
  <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
    <div>
      <p class="text-uppercase text-body-secondary mb-1">Project detail</p>
      <h1 class="h3 mb-0"><%= @project.name.presence || "Untitled project" %></h1>
    </div>
    <%= link_to "Back to projects", projects_path, class: "btn btn-outline-secondary" %>
  </div>

  <div class="card shadow-sm border-0 mb-4">
    <div class="card-body p-4">
      <% if youtube_embed_url(@project.youtube_url).present? %>
        <div class="ratio ratio-16x9 rounded overflow-hidden bg-dark mb-4">
          <iframe
            src="<%= youtube_embed_url(@project.youtube_url) %>"
            title="<%= @project.name.presence || "Project video" %>"
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
            allowfullscreen
          ></iframe>
        </div>
      <% end %>

      <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-start gap-3 mb-4">
        <div>
          <p class="text-uppercase text-body-secondary small mb-1">Status</p>
          <span class="badge <%= @project.pending? ? "text-bg-secondary" : @project.in_progress? ? "text-bg-info" : @project.completed? ? "text-bg-success" : "text-bg-warning" %> text-uppercase">
            <%= @project.pending? ? "Pendiente" : @project.in_progress? ? "En progreso" : @project.completed? ? "Completado" : "Borrador" %>
          </span>
        </div>

        <div class="d-flex flex-wrap gap-2" data-role-scope="pm">
          <% if @project.pending? %>
            <%= button_to "Aceptar proyecto", accept_project_path(@project), method: :patch, class: "btn btn-outline-primary" %>
          <% elsif @project.in_progress? %>
            <%= button_to "Marcar como completado", complete_project_path(@project), method: :patch, class: "btn btn-outline-success" %>
          <% end %>
        </div>
      </div>

      <dl class="row mb-0">
        <dt class="col-sm-3 text-body-secondary">Client</dt>
        <dd class="col-sm-9"><%= @project.client.name %></dd>

        <dt class="col-sm-3 text-body-secondary">PM</dt>
        <dd class="col-sm-9"><%= @project.pm.name %></dd>

        <dt class="col-sm-3 text-body-secondary">Raw footage</dt>
        <dd class="col-sm-9"><%= @project.raw_footage_url.presence || "No footage URL yet" %></dd>

        <dt class="col-sm-3 text-body-secondary">YouTube</dt>
        <dd class="col-sm-9">
          <% if @project.youtube_url.present? %>
            <%= link_to @project.youtube_url, @project.youtube_url, target: "_blank", rel: "noopener" %>
          <% else %>
            <span class="text-body-secondary">No YouTube preview linked yet.</span>
          <% end %>
        </dd>
      </dl>
    </div>
  </div>

  <div id="project-comments" class="card shadow-sm border-0">
    <div class="card-body p-4">
      <div class="d-flex justify-content-between align-items-center gap-3 mb-3">
        <div>
          <p class="text-uppercase text-body-secondary small mb-1">Conversation</p>
          <h2 class="h5 mb-0">Comments</h2>
        </div>
        <span id="project-comments-count" class="badge text-bg-dark"><%= @comments.size %></span>
      </div>

      <div id="project-comments-list" class="vstack gap-3 mb-4">
        <% if @comments.any? %>
          <%= render partial: "comment", collection: @comments, as: :comment %>
        <% else %>
          <p id="project-comments-empty" class="text-body-secondary mb-4">No comments yet.</p>
        <% end %>
      </div>

      <%= render "comment_form", project: @project, comment: @comment %>
    </div>
  </div>
</div>
