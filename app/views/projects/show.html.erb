<% content_for :title, @project.name.presence || "Project details" %>

<div class="container py-4" data-role-scope="pm">
  <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
    <div>
      <p class="text-uppercase text-body-secondary mb-1">Project detail</p>
      <h1 class="h3 mb-0"><%= @project.name.presence || "Untitled project" %></h1>
    </div>
    <%= link_to "Back to projects", projects_path, class: "btn btn-outline-secondary" %>
  </div>

  <div class="card shadow-sm border-0">
    <div class="card-body p-4">
      <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-start gap-3 mb-4">
        <div>
          <p class="text-uppercase text-body-secondary small mb-1">Status</p>
          <span class="badge <%= @project.pending? ? "text-bg-secondary" : @project.in_progress? ? "text-bg-info" : @project.completed? ? "text-bg-success" : "text-bg-warning" %> text-uppercase">
            <%= @project.pending? ? "Pendiente" : @project.in_progress? ? "En progreso" : @project.completed? ? "Completado" : "Borrador" %>
          </span>
        </div>

        <div class="d-flex flex-wrap gap-2">
          <% if @project.pending? %>
            <%= button_to "Aceptar proyecto", accept_project_path(@project), method: :patch, class: "btn btn-outline-primary" %>
          <% elsif @project.in_progress? %>
            <%= button_to "Marcar como completado", complete_project_path(@project), method: :patch, class: "btn btn-outline-success" %>
          <% end %>
        </div>
      </div>

      <dl class="row mb-0">
        <dt class="col-sm-3 text-body-secondary">Client</dt>
        <dd class="col-sm-9"><%= @project.client.name %></dd>

        <dt class="col-sm-3 text-body-secondary">PM</dt>
        <dd class="col-sm-9"><%= @project.pm.name %></dd>

        <dt class="col-sm-3 text-body-secondary">Raw footage</dt>
        <dd class="col-sm-9"><%= @project.raw_footage_url.presence || "No footage URL yet" %></dd>
      </dl>

      <div class="mt-4">
        <p class="text-uppercase text-body-secondary small mb-2">Video types</p>
        <% if @project.video_types.any? %>
          <ul class="list-unstyled mb-0">
            <% @project.video_type_selections.includes(:video_type).each do |selection| %>
              <li class="d-flex justify-content-between gap-3 py-1">
                <span><%= selection.video_type.name %></span>
                <span class="text-body-secondary">Qty <%= selection.quantity %></span>
              </li>
            <% end %>
          </ul>
        <% else %>
          <p class="mb-0 text-body-secondary">No selections recorded yet.</p>
        <% end %>
      </div>
    </div>
  </div>
</div>
