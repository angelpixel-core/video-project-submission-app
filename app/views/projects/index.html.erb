<% content_for :title, "Projects" %>

<div class="container py-4">
  <div data-role-scope="client" class="vstack gap-4 mb-4">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">
      <div>
        <p class="text-uppercase text-body-secondary mb-1">Client workspace</p>
        <h1 class="h3 mb-0"><%= current_client.name %> projects</h1>
      </div>
      <%= link_to "New Order", new_project_path, class: "btn btn-primary" %>
    </div>

    <div>
      <% if @projects.any? %>
        <div class="row g-3">
          <%= render partial: "project", collection: @projects, as: :project %>
        </div>
      <% else %>
        <div class="card border-0 shadow-sm">
          <div class="card-body p-4">
            <h2 class="h5">No projects yet</h2>
            <p class="mb-3 text-body-secondary">Start a new order to create the first project for <%= current_client.name %>.</p>
            <%= link_to "Create order", new_project_path, class: "btn btn-primary" %>
          </div>
        </div>
      <% end %>
    </div>
  </div>

  <div data-role-scope="pm" class="vstack gap-4">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">
      <div>
        <p class="text-uppercase text-body-secondary mb-1">PM workspace</p>
        <h1 class="h3 mb-0"><%= default_pm.name %> projects</h1>
      </div>
    </div>

    <div class="card border-0 shadow-sm">
      <div class="card-body p-4">
        <div class="d-flex justify-content-between align-items-center gap-3 mb-3">
          <div>
            <h2 class="h5 mb-0">Assigned projects</h2>
          </div>
          <span class="badge text-bg-dark"><%= @pm_projects.to_a.size %></span>
        </div>

        <div class="table-responsive">
          <table class="table table-hover align-middle mb-0 pm-projects-table">
            <colgroup>
              <col class="pm-projects-col-id">
              <col class="pm-projects-col-project">
              <col class="pm-projects-col-created">
              <col class="pm-projects-col-budget">
              <col class="pm-projects-col-status">
              <col class="pm-projects-col-actions">
            </colgroup>
            <thead>
              <tr>
                <th scope="col"><%= pm_table_sort_link("ID", "id", @pm_sort, @pm_direction, @pm_page) %></th>
                <th scope="col">Project</th>
                <th scope="col"><%= pm_table_sort_link("Created at", "created_at", @pm_sort, @pm_direction, @pm_page) %></th>
                <th scope="col"><%= pm_table_sort_link("Total budget", "total_budget", @pm_sort, @pm_direction, @pm_page) %></th>
                <th scope="col">Status</th>
                <th scope="col" class="text-end">Actions</th>
              </tr>
            </thead>
            <tbody id="pm-projects-table-body">
              <% if @pm_projects.any? %>
                <%= render partial: "pm_project_table_row", collection: @pm_projects, as: :project %>
              <% else %>
                <tr>
                  <td colspan="6" class="text-body-secondary py-4">No projects yet.</td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>

        <% if @pm_total_pages.to_i > 1 %>
          <nav aria-label="PM projects pagination" class="mt-4">
            <ul class="pagination justify-content-center flex-wrap gap-2 mb-0 pm-projects-pagination">
              <li class="page-item <%= @pm_page.to_i <= 1 ? 'disabled' : '' %>">
                <% if @pm_page.to_i <= 1 %>
                  <span class="page-link">Prev</span>
                <% else %>
                  <%= link_to "Prev", projects_path(pm_table_query_params(page: @pm_page.to_i - 1, sort: @pm_sort, direction: @pm_direction)), class: "page-link" %>
                <% end %>
              </li>

              <% pagination_pages = [1, 2, @pm_page.to_i - 1, @pm_page.to_i, @pm_page.to_i + 1, @pm_total_pages.to_i].select { |page| page.between?(1, @pm_total_pages.to_i) }.uniq.sort %>
              <% pagination_pages.each_with_index do |page_number, index| %>
                <% previous_page = index.positive? ? pagination_pages[index - 1] : nil %>
                <% if previous_page && page_number > previous_page + 1 %>
                  <li class="page-item disabled"><span class="page-link">...</span></li>
                <% end %>

                <li class="page-item <%= 'active' if page_number == @pm_page.to_i %>">
                  <%= link_to page_number, projects_path(pm_table_query_params(page: page_number, sort: @pm_sort, direction: @pm_direction)), class: "page-link" %>
                </li>
              <% end %>

              <li class="page-item <%= @pm_page.to_i >= @pm_total_pages.to_i ? 'disabled' : '' %>">
                <% if @pm_page.to_i >= @pm_total_pages.to_i %>
                  <span class="page-link">Next</span>
                <% else %>
                  <%= link_to "Next", projects_path(pm_table_query_params(page: @pm_page.to_i + 1, sort: @pm_sort, direction: @pm_direction)), class: "page-link" %>
                <% end %>
              </li>
            </ul>
          </nav>
        <% end %>

      </div>
    </div>
  </div>

  <div id="pm-notifications-panel" data-role-scope="pm" class="pm-notifications-toast-host position-fixed bottom-0 end-0 p-3 d-flex flex-column gap-3 align-items-end">
    <% if unread_notifications.any? %>
      <div class="visually-hidden" aria-live="polite">
        <%= unread_notifications.size %> unread PM notifications
      </div>

      <div class="pm-notifications-stack d-flex flex-column gap-3 align-items-end w-100">
        <div class="d-none d-lg-flex align-self-end badge text-bg-dark px-3 py-2 shadow-sm">
          <%= unread_notifications.size %>
        </div>

        <div class="vstack gap-3 w-100 align-items-end">
          <%= render partial: "notification", collection: unread_notifications, as: :notification %>
        </div>
      </div>
    <% end %>
  </div>
</div>
