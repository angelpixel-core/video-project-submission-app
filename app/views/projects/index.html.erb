<% content_for :title, "Projects" %>

<div class="container py-4">
  <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
    <div>
      <p class="text-uppercase text-body-secondary mb-1">Client workspace</p>
      <h1 class="h3 mb-0"><%= current_client.name %> projects</h1>
    </div>
    <%= link_to "New Order", new_project_path, class: "btn btn-primary" %>
  </div>

  <% if @projects.any? %>
    <div class="row g-3">
      <%= render partial: "project", collection: @projects, as: :project %>
    </div>
  <% else %>
    <div class="card border-0 shadow-sm">
      <div class="card-body p-4">
        <h2 class="h5">No projects yet</h2>
        <p class="mb-3 text-body-secondary">Start a new order to create the first project for <%= current_client.name %>.</p>
        <%= link_to "Create order", new_project_path, class: "btn btn-primary" %>
      </div>
    </div>
  <% end %>
</div>
