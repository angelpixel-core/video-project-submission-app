<% content_for :title, "Resume Draft" %>

<div class="container py-4" data-controller="order-form" data-project-id="<%= @project.id %>" data-role-scope="client">
  <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
    <div>
      <p class="text-uppercase text-body-secondary mb-1">Order flow</p>
      <h1 class="h3 mb-0"><%= @project.draft? ? "Resume draft" : "Edit order" %></h1>
    </div>
    <%= link_to "Back to orders", orders_path, class: "btn btn-outline-secondary" %>
  </div>

  <% if @project.errors.any? %>
    <div class="alert alert-danger">
      <strong>Please fix the following:</strong>
      <ul class="mb-0">
        <% @project.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <%= form_with model: @project, url: order_path(@project), method: :patch, data: { action: "submit->order-form#submit", order_form_target: "form" } do |form| %>
    <%= hidden_field_tag "project[selections_json]", @selections_json, data: { order_form_target: "selectionsJson" } %>
    <%= hidden_field_tag "project[finalize]", "0", data: { order_form_target: "finalize" } %>

    <div class="row g-4">
      <div class="col-12 col-lg-8">
        <div class="card shadow-sm border-0 mb-4">
          <div class="card-body">
            <h2 class="h5 mb-3">Order details</h2>

            <div class="mb-3">
              <%= form.label :name, class: "form-label" %>
              <%= form.text_field :name, class: "form-control", placeholder: "Order name", data: { order_form_target: "name", action: "input->order-form#syncFields" } %>
            </div>

            <div class="mb-0">
              <%= form.label :raw_footage_url, "Raw footage URL", class: "form-label" %>
              <%= form.url_field :raw_footage_url, class: "form-control", placeholder: "https://...", data: { order_form_target: "rawFootageUrl", action: "input->order-form#syncFields blur->order-form#validateRawFootageUrl" }, aria: { describedby: "raw-footage-url-feedback" } %>
              <div id="raw-footage-url-feedback" class="invalid-feedback d-none" data-order-form-target="rawFootageUrlFeedback"></div>
              <div id="raw-footage-preview" class="raw-footage-preview mt-3" data-order-form-target="rawFootagePreview" aria-live="polite" aria-atomic="true"></div>
            </div>
          </div>
        </div>

        <div class="card shadow-sm border-0">
          <div class="card-body">
            <div class="d-flex justify-content-between align-items-center mb-3">
              <h2 class="h5 mb-0">Available video types</h2>
              <span class="text-body-secondary"><%= @video_types.count %> options</span>
            </div>

            <div class="row g-3">
              <%= render partial: "video_type", collection: @video_types, as: :video_type %>
            </div>
          </div>
        </div>
      </div>

      <div class="col-12 col-lg-4">
        <div class="card shadow-sm border-0 sticky-lg-top" style="top: 1rem;">
          <div class="card-body">
            <div class="d-flex justify-content-between align-items-center mb-3">
              <h2 class="h5 mb-0">Cart</h2>
              <span class="badge text-bg-secondary" data-order-form-target="cartTotal">$0.00</span>
            </div>

            <ul class="list-group list-group-flush mb-3" data-order-form-target="cartItems">
              <li class="list-group-item text-body-secondary">No selections yet.</li>
            </ul>

            <div class="d-grid gap-2">
              <button type="button" class="btn btn-outline-primary disabled" disabled data-order-form-target="reviewButton" data-action="click->order-form#openPaymentModal">Review and pay</button>
            </div>

            <p class="small text-body-secondary mb-0 mt-3" data-order-form-status></p>
          </div>
        </div>
      </div>
    </div>

    <%= render "payment_modal", form: form %>
  <% end %>
</div>
